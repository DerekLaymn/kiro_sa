{"case_id": "20261027-194720-06f0236c", "source": "import asyncio\nfrom typing import AsyncIterator, Awaitable, reveal_type\n\n\nasync def nums(n: int) -> AsyncIterator[int]:\n    for i in range(n):\n        yield i\n\n\nasync def dbl(x: int) -> int:\n    return x * 2\n\n\nasync def main() -> None:\n    a = [await dbl(x) async for x in nums(3)]\n    reveal_type(a)\n    b = {x: await dbl(x) async for x in nums(3)}\n    reveal_type(b)\n    c = (x async for x in nums(2))\n    reveal_type(c)\n    d = [x async for x in nums(4) if await dbl(x) > 2]\n    reveal_type(d)\n    e = [dbl(x) for x in range(3)]\n    reveal_type(e)\n    f: list[Awaitable[int]] = e\n    g = await asyncio.gather(*f)\n    reveal_type(g)\n    print(a, b, [x async for x in c], d, g)\n\n\nasyncio.run(main())\n", "target_python": "3.13", "tool_versions": {"mypy": "mypy 2.4.0 (compiled: yes)", "ty": "ty 0.0.84", "pyright": "Please install the new version or set PYRIGHT_PYTHON_FORCE_VERSION to `latest`", "runtime": "3.13.16"}, "flags": {"mypy": ["--python-version", "3.13", "--check-untyped-defs", "--show-column-numbers", "--show-error-codes", "--show-error-end", "--no-error-summary", "--no-color-output", "--hide-error-context", "--no-incremental", "--cache-dir", "/tmp/typediff-92ijazx1/.mypy_cache"], "ty": ["--python-version", "3.13", "--output-format", "concise", "--no-progress", "--color", "never"], "pyright": ["--pythonversion", "3.13", "--outputjson"]}, "diagnostics": {"mypy": [{"tool": "mypy", "line": 16, "col": 17, "severity": "note", "code": null, "message": "Revealed type is \"list[int]\"", "end_line": 16, "end_col": 17, "revealed_type": "list[int]", "anchor": 16, "raw": "case.py:16:17:16:17: note: Revealed type is \"list[int]\""}, {"tool": "mypy", "line": 18, "col": 17, "severity": "note", "code": null, "message": "Revealed type is \"dict[int, int]\"", "end_line": 18, "end_col": 17, "revealed_type": "dict[int, int]", "anchor": 18, "raw": "case.py:18:17:18:17: note: Revealed type is \"dict[int, int]\""}, {"tool": "mypy", "line": 20, "col": 17, "severity": "note", "code": null, "message": "Revealed type is \"typing.AsyncGenerator[int, None]\"", "end_line": 20, "end_col": 17, "revealed_type": "typing.AsyncGenerator[int, None]", "anchor": 20, "raw": "case.py:20:17:20:17: note: Revealed type is \"typing.AsyncGenerator[int, None]\""}, {"tool": "mypy", "line": 22, "col": 17, "severity": "note", "code": null, "message": "Revealed type is \"list[int]\"", "end_line": 22, "end_col": 17, "revealed_type": "list[int]", "anchor": 22, "raw": "case.py:22:17:22:17: note: Revealed type is \"list[int]\""}, {"tool": "mypy", "line": 24, "col": 17, "severity": "note", "code": null, "message": "Revealed type is \"list[typing.Coroutine[Any, Any, int]]\"", "end_line": 24, "end_col": 17, "revealed_type": "list[typing.Coroutine[Any, Any, int]]", "anchor": 24, "raw": "case.py:24:17:24:17: note: Revealed type is \"list[typing.Coroutine[Any, Any, int]]\""}, {"tool": "mypy", "line": 25, "col": 31, "severity":
