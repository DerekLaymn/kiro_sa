# area: protocols
# hypothesis: two generic protocols whose method takes the other protocol specialised with a method-level TypeVar, with T1 made contravariant and a third protocol added, are accepted by mypy and pyright but make ty overflow its stack.
# features: generic_protocol, contravariant_typevar, method_typevar, union_of_protocols, third_protocol
from typing import Protocol, TypeVar, reveal_type

T1 = TypeVar('T1', contravariant=True)
T2 = TypeVar('T2')


class P1(Protocol[T1]):
    def b(self) -> int: ...
    def a(self, other: 'P1[T2]') -> int: ...


class P2(Protocol[T1]):
    def a(self, other: 'P1[T2] | P2[T2]') -> int: ...


class P3(Protocol[T1]):
    def c(self, other: 'P2[T2]') -> int: ...


class Impl:
    def b(self) -> int:
        return 7

    def a(self, other: object) -> int:
        return 1

    def c(self, other: object) -> int:
        return 3


x1: P1[int] = Impl()
x2: P2[int] = Impl()
x3: P3[int] = Impl()
reveal_type(x1)
print(x1.b(), x2.a(x1), x3.c(x2))

