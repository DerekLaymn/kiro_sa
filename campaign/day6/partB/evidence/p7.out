# area: protocols
# hypothesis: A plain class with an unannotated flatten method is accepted as Stream[int] although the protocol annotates self as Stream[Stream[T]]; the runtime isinstance check returns True.
from typing import Protocol, reveal_type, runtime_checkable


@runtime_checkable
class Stream[T](Protocol):
    def flatten(self: 'Stream[Stream[T]]') -> None: ...


class Impl:
    def flatten(self) -> None:
        print('flatten', type(self).__name__)


class Pair[T]:
    def __init__(self, first: T, second: T) -> None:
        self.first = first
        self.second = second

    def flatten(self) -> None:
        print('pair', self.first, self.second)


def check(s: Stream[int]) -> str:
    return type(s).__name__


x: Stream[int] = Impl()
reveal_type(x)
print(check(x), isinstance(x, Stream))
p: Stream[int] = Pair(1, 2)
print(check(p), isinstance(p, Stream))
Impl().flatten()
Pair(3, 4).flatten()

