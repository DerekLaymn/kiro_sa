# Copy to .env and fill in what you need. typediff reads plain environment variables and does not
# load this file by itself. Export it into your shell first:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# .env is git-ignored. Never commit real keys.

# --- LLM provider (only needed for `generate`, `loop` and the LLM judge; the default is no LLM) ---
# One of:
#   null                                         no LLM (default; deterministic stages only)
#   anthropic:<model>                            uses ANTHROPIC_API_KEY
#   openai:<model>                               uses OPENAI_API_KEY (and OPENAI_BASE_URL if set)
#   openai:<model>@http://localhost:8000/v1      any OpenAI-compatible server (vLLM, Ollama, LiteLLM)
#   file:<dir>                                   prompts are written to <dir>, answers are read from <dir>
TYPEDIFF_LLM=null

# Put your API key here (placeholder values only in this example file).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: base URL of an OpenAI-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# --- Optional tuning ---
# Seconds to wait between LLM requests (default 0)
TYPEDIFF_LLM_MIN_INTERVAL=0
# Directory of the on-disk LLM response cache (default ~/.cache/typediff/llm)
# TYPEDIFF_CACHE=
# Directory of the downloaded checker documentation (default ~/.cache/typediff/docs)
# TYPEDIFF_DOCS=

# --- Tool overrides (default: the executables next to the Python interpreter, then PATH) ---
# TYPEDIFF_MYPY=mypy
# TYPEDIFF_TY=ty
# TYPEDIFF_PYRIGHT=pyright
# Python used to run the generated programs for the runtime oracle (default: the current interpreter)
# TYPEDIFF_RUNTIME_PYTHON=python3.13
