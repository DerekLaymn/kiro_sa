# Copy to .env and fill in what you need:
#
#   cp .env.example .env
#
# The `typediff` command reads the file `.env` in the directory you run it from (simple KEY=value lines).
# A variable that is already set in your shell is never overridden. Empty values (like the keys below) are ignored.
# The scripts in scripts/ do not read .env: export the variables first (`set -a; . ./.env; set +a`).
# TYPEDIFF_CACHE and TYPEDIFF_DOCS are read when Python starts, so set those two in the shell, not here.
#
# .env is git-ignored. Never commit real keys. Nothing in the test suite or in scripts/reproduce.sh needs a key.

# --- LLM provider (only needed for `generate`, `loop` and the LLM judge; the default is no LLM) ---
# One of:
#   null                                         no LLM (default; deterministic stages only)
#   anthropic:<model>                            uses ANTHROPIC_API_KEY
#   openai:<model>                               uses OPENAI_API_KEY (and OPENAI_BASE_URL if set)
#   openai:<model>@http://localhost:8000/v1      any OpenAI-compatible server (vLLM, Ollama, LiteLLM)
#   file:<dir>                                   prompts are written to <dir>, answers are read from <dir>
TYPEDIFF_LLM=null

# Put your API key here (placeholder values only in this example file). If the provider in TYPEDIFF_LLM needs a key
# that is missing, typediff stops with "error: ANTHROPIC_API_KEY is not set ..." (exit code 2).
# OPENAI_API_KEY may stay empty when you use a local OpenAI-compatible server (a base URL is set).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: base URL of an OpenAI-compatible endpoint (default https://api.openai.com/v1)
OPENAI_BASE_URL=

# --- Optional tuning ---
# Seconds to wait between LLM requests (default 0)
TYPEDIFF_LLM_MIN_INTERVAL=0
# Directory of the on-disk LLM response cache (default ~/.cache/typediff/llm)
# TYPEDIFF_CACHE=
# Directory of the downloaded checker documentation (default ~/.cache/typediff/docs)
# TYPEDIFF_DOCS=

# --- Tool overrides (default: the executables next to the Python interpreter, then PATH) ---
# TYPEDIFF_MYPY=mypy
# TYPEDIFF_TY=ty
# TYPEDIFF_PYRIGHT=pyright
# Memory limit in MB for each mypy and ty process (default: unlimited). Set it when you judge the seeds or a large corpus:
# one seed program makes mypy use many GB before it crashes. scripts/reproduce.sh and replay_day10.sh default to 4096.
# TYPEDIFF_TOOL_MEM_MB=4096

# Python used to run the generated programs for the runtime oracle (default: the current interpreter)
# TYPEDIFF_RUNTIME_PYTHON=python3.13
